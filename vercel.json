{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/late-check",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/auto-checkout",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 19 * * *"
    }
  ]
}
